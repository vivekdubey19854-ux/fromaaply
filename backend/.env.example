# Formwise backend
FORMWISE_ENVIRONMENT=development
FORMWISE_DATABASE_URL=sqlite:///./formwise.db
FORMWISE_STORAGE_ROOT=./private_storage
FORMWISE_MAX_UPLOAD_SIZE_BYTES=10485760
FORMWISE_BROWSER_HEADLESS=true
FORMWISE_BROWSER_ALLOW_LOCAL_DEMO_TARGET=true
FORMWISE_BROWSER_DEMO_TARGET_PORT=5000
FORMWISE_BROWSER_BLOCK_PRIVATE_NETWORKS=true
FORMWISE_JWT_SECRET=change-me-in-production
FORMWISE_ALLOW_LEGACY_USER_HEADER=true
FORMWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The local demo flag is development-only and permits ONLY localhost/127.0.0.1:5000.
# Production must use a strong FORMwise JWT secret and disable X-User-ID.
# Real government targets should not be enabled through the demo flag.
