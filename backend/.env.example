# Formwise backend
FORMWISE_ENVIRONMENT=development
FORMWISE_DATABASE_URL=sqlite:///./formwise.db
FORMWISE_STORAGE_ROOT=./private_storage
FORMWISE_MAX_UPLOAD_SIZE_BYTES=10485760
FORMWISE_BROWSER_HEADLESS=true
FORMWISE_BROWSER_ALLOW_LOCAL_DEMO_TARGET=true
FORMWISE_BROWSER_DEMO_TARGET_PORT=5000
FORMWISE_BROWSER_BLOCK_PRIVATE_NETWORKS=true
FORMWISE_JWT_SECRET=replace-with-at-least-32-random-characters
FORMWISE_ALLOW_LEGACY_USER_HEADER=true
FORMWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORMWISE_FRONTEND_BASE_URL=http://localhost:5173
FORMWISE_EMAIL_PROVIDER=brevo
FORMWISE_EMAIL_DELIVERY_ENABLED=false
FORMWISE_REDIS_URL=redis://localhost:6379/0
FORMWISE_TASK_QUEUE_NAME=formwise:tasks
FORMWISE_TASK_DEAD_LETTER_QUEUE_NAME=formwise:tasks:dead
FORMWISE_TASK_WORKER_LEASE_SECONDS=60
FORMWISE_TASK_MAX_RETRIES=3

# Production database/storage
# FORMWISE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/formwise
# FORMWISE_STORAGE_PROVIDER=s3
# FORMWISE_S3_ENDPOINT_URL=https://...
# FORMWISE_S3_BUCKET=formwise-private
# FORMWISE_S3_ACCESS_KEY_ID=
# FORMWISE_S3_SECRET_ACCESS_KEY=
# FORMWISE_S3_REGION=ap-south-1

# Set through the encrypted admin provider-key endpoint, not in source control:
# brevo -> {"api_key":"...","sender_email":"no-reply@example.com","sender_name":"Formwise"}
# openai/gemini/anthropic/groq/... -> provider-specific credential payload
# razorpay -> {"key_id":"...","key_secret":"...","webhook_secret":"..."}

# Production must use a strong JWT secret, disable local demo targets,
# set FORMWISE_ALLOW_LEGACY_USER_HEADER=false, and use HTTPS/WSS.
